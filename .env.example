STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_DEMO_SECRET_KEY=your_stripe_test_secret_key_here
ADMIN_PASSWORD=replace_me
# Live-mode webhook signing secret (whsec_...). Set on the Worker via `wrangler secret put`.
STRIPE_WEBHOOK_SECRET=created_when_you_add_the_live_stripe_webhook_endpoint
# Optional: test-mode webhook signing secret, only if you also point a test webhook at the Worker.
STRIPE_DEMO_WEBHOOK_SECRET=created_when_you_add_the_test_stripe_webhook_endpoint
PUBLIC_APP_URL=http://localhost:5173
PORT=5173
