{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swrm-payment-checkout",
  "account_id": "712edbd8c5005745cf417a2338a3df91",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swrm-payment-store",
      "database_id": "586ee9ba-72ba-4780-8327-b7e992ad6b51",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["noreplySWRM2026@jeremiahsrandom.website"]
    }
  ],
  "vars": {
    "FRONTEND_URL": "https://jgassens.github.io/SWRM-payment-website",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5180,http://localhost:5180,https://jgassens.github.io",
    "EMAIL_FROM": "noreplySWRM2026@jeremiahsrandom.website",
    // Sender name recipients see next to the address.
    "EMAIL_FROM_NAME": "SWRM 2026 Registration",
    // Set this to a monitored address (registration chair, conference inbox) and redeploy. It
    // becomes the Reply-To and the "Questions" line in the email. Left empty the line is
    // omitted entirely, because a contact address that bounces looks worse than none.
    "EMAIL_REPLY_TO": "",
    "EVENT_SITE_URL": "https://swrm.org",
    "EMAIL_VERIFICATION_REQUIRED": "true"
  }
}
